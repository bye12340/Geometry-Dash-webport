<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_svg.py; edit index.html or tools/index.svg.in. -->
<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"
     xml:lang="en" role="document" aria-labelledby="title description">
  <title id="title">Geometry Dash Webport</title>
  <desc id="description">Open this SVG in a browser tab to play the WebAssembly game. An Internet connection is needed for the first load.</desc>

  <!-- Image-only viewers cannot run a game. Give them a scalable cover. -->
  <svg id="cover" width="100%" height="100%" viewBox="0 0 640 360">
    <rect width="640" height="360" rx="12" fill="#112444"/>
    <g transform="translate(320 115) rotate(-12)" stroke="#112444" stroke-width="5">
      <rect x="-32" y="-32" width="64" height="64" rx="5" fill="#a7fa45" stroke="#d3ff9c"/>
      <path d="M-17 -12h9v9h-9z M8 -12h9v9H8z M-17 8h34v9h-34z" fill="#112444"/>
    </g>
    <g text-anchor="middle" font-family="system-ui, sans-serif">
      <text x="320" y="204" font-size="36" font-weight="bold" fill="white">Geometry Dash Webport</text>
      <text x="320" y="243" font-size="18" fill="#d6e8ff">Open the SVG in a browser tab to play.</text>
      <a href="https://gd-webport.pages.dev/">
        <text x="320" y="288" font-size="16" fill="#a7fa45" text-decoration="underline">Play the web version</text>
      </a>
    </g>
  </svg>

  <foreignObject id="stage" width="100%" height="100%" display="none">
    <iframe xmlns="http://www.w3.org/1999/xhtml" id="gd-svg-game" title="Geometry Dash game"
            allow="autoplay" allowfullscreen="allowfullscreen"
            style="display:block; width:100%; height:100%; border:0; background:#000"></iframe>
  </foreignObject>

  <metadata id="local-launcher"><![CDATA[@@INDEX_HTML@@]]></metadata>
  <script><![CDATA[
    (function () {
      var frame = document.getElementById('gd-svg-game');
      frame.addEventListener('load', function () { frame.focus(); }, {once: true});
      if (location.protocol === 'file:') {
        // A downloaded SVG needs no companion file. Keep the game in a real
        // HTML document so canvas, Web Audio, storage and the loader work.
        frame.srcdoc = document.getElementById('local-launcher').textContent;
      } else if (location.protocol === 'https:' || location.protocol === 'http:') {
        // On a web host, use the actual page with its normal origin, MIME
        // type and hosting policies. The bundled copy is for local use only.
        var page = new URL('index.html', location.href);
        page.search = location.search;
        page.hash = location.hash;
        frame.src = page.href;
      } else {
        return;
      }
      document.getElementById('cover').setAttribute('display', 'none');
      document.getElementById('stage').removeAttribute('display');
    })();
  ]]></script>
</svg>
